{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": false,
    "singleQuote": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": ["no-console"]
    }
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check .",
    "test": "deno test --allow-env --allow-read"
  }
}
