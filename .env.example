# Solo NOMI delle variabili: nessun valore reale va mai scritto in questo repo.
# Dove vive davvero ciascun valore: docs/ARCHITECTURE.md §10.

# --- Frontend (pubblici per design, impostati da GitHub Actions al build) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_APP_ENV=            # dev | prod
VITE_BUILD_INFO=         # PR/SHA mostrati nel badge

# --- Edge Functions (secret Supabase, inseriti dalla dashboard) ---
# EB_APP_ID=             # app_id Enable Banking (sandbox su dev, production su prod)
# EB_PRIVATE_KEY=        # contenuto del file .pem — SOLO nella dashboard Supabase
# FRONTEND_URL=          # impostato dalla CI
# HEALTH_TOKEN=          # anche su GitHub (keepalive)
